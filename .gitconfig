[user]
	name = Aaron Davis
	email = adavi2048@gmail.com
[push]
	autoSetupRemote = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ayu-dark
	dark = true
	minus-style = syntax "#2D2220"
	minus-emph-style = syntax "#4D2A28"
	plus-style = syntax "#1D2214"
	plus-emph-style = syntax "#2F3A1C"
	true-color = always
[diff]
	colorMoved = default
	algorithm = histogram
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
# Per-machine settings, outside the repo. install.sh writes it to turn on
# commit signing (see ~/.config/git/signing.gitconfig). Missing file is fine.
[include]
	path = ~/.gitconfig.local
