[user]
	name = Aaron Davis
	email = adavi2048@gmail.com
	# Public half of the SSH key. The private key never leaves ~/.ssh and is
	# unlocked by the SSH agent. Works with any forge (GitHub, Bitbucket, Gitea)
	# once this public key is registered there as a signing key.
	signingKey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	# Local list of trusted signers for `git log --show-signature`.
	# Generated by install.sh, lives outside the repo.
	allowedSignersFile = ~/.ssh/allowed_signers
[tag]
	gpgSign = true
[push]
	autoSetupRemote = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ayu-dark
	dark = true
	minus-style = syntax "#2D2220"
	minus-emph-style = syntax "#4D2A28"
	plus-style = syntax "#1D2214"
	plus-emph-style = syntax "#2F3A1C"
	true-color = always
[diff]
	colorMoved = default
	algorithm = histogram
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
	gpgSign = true
[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
