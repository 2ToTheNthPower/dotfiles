# SSH commit signing. Included from ~/.gitconfig.local, which install.sh writes
# on machines that have an SSH key and git 2.34+. That file also sets
# user.signingKey to this machine's *public* key; the private key stays in
# ~/.ssh and is unlocked by the SSH agent.
#
# Forge-agnostic: GitHub, Bitbucket, and Gitea all verify these signatures once
# the public key is registered there as a signing key.
[gpg]
	format = ssh
[gpg "ssh"]
	# Trusted signers for `git log --show-signature`; generated by install.sh.
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgSign = true
[tag]
	gpgSign = true
